# POG local defaults. Copy to .env.pog; existing private configuration is never loaded.
POG_DB_PATH=.data/pog.db
POG_LISTEN_HOST=127.0.0.1
PORT=3001
POG_AUTOMATION_ENABLED=false
POG_TRANSACTIONS_ENABLED=false
POG_LAUNCHES_ENABLED=false
POG_ALLOWED_ORIGINS=http://127.0.0.1:5178
POG_WORKER_INTERVAL_MS=30000
POG_MAX_GIFT_USD_CENTS=50000
POG_GIFT_UNITS=10
POG_MAX_DEPOSIT_LAMPORTS=1000000000
POG_GAS_RESERVE_LAMPORTS=1000000
# Set non-secret network/account bindings after verification.
POG_SOLANA_GENESIS_HASH=
POG_COINBASE_ACCOUNT_ID=
POG_COINBASE_SOL_ADDRESS=
POG_CARD_ACCOUNT_ID=
POG_CARD_LAST4=
BROWSERBASE_PROJECT_ID=
POG_TWITCH_ACCOUNT_ID=
POG_TWITCH_CONTEXT_ID=
POG_KICK_ACCOUNT_ID=
POG_KICK_CONTEXT_ID=
# Inject POG_VAULT_KEY via workload secret manager. Never commit a wrapping key.
# API keys, RPC URL, launch wrapping key and OAuth client secrets belong in SecretVault.
# See README.md and docs/security.md for role names and service provisioning.

# Trusted local module exporting createWorkerBindings({db,env}); see README.
POG_WORKER_BINDINGS_MODULE=

# Official platform token: $POG on Robinhood Chain (4663).
# Configure its reviewed token contract, code hash, dev wallet and transfer/swap/burn
# adapters in the trusted worker module's buyback options. No default live addresses.
# The encrypted dev-wallet key is read with secrets.forRole('treasury').
